{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".validate": "!newData.exists() || root.child('users').child(auth.uid).child('isAdmin').val() === true || ((!data.exists() || newData.child('isAdmin').val() === data.child('isAdmin').val()) && (!data.exists() || newData.child('banned').val() === data.child('banned').val()))"
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('createdBy').val() === auth.uid))",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "createdBy": {
          ".validate": "newData.isString()"
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || (data.exists() && newData.child('uid').val() === data.child('uid').val() && newData.child('text').val() === data.child('text').val() && newData.child('fileURL').val() === data.child('fileURL').val() && newData.child('fileName').val() === data.child('fileName').val() && newData.child('displayName').val() === data.child('displayName').val() && newData.child('photoURL').val() === data.child('photoURL').val()))"
          }
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "dms": {
      "$dmId": {
        ".read": "auth != null && $dmId.contains(auth.uid)",
        ".write": "auth != null && $dmId.contains(auth.uid)",
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
