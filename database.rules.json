{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        "name": {
          ".write": "auth != null && (!data.exists() || data.val() === newData.val())"
        },
        "createdBy": {
          ".write": "auth != null && !data.exists()"
        },
        "messages": {
          ".write": "auth != null",
          "$messageId": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || newData.child('seenBy').exists())"
          }
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "dms": {
      "$dmId": {
        ".read": "auth != null && $dmId.contains(auth.uid)",
        ".write": "auth != null && $dmId.contains(auth.uid)",
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
